#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <4>;
        };
    };

    macros {
        m_wclick: m_wclick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp LCLK &mkp LCLK>;
            label = "M_WCLICK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB        &kp Q         &kp W         &kp E  &kp R  &kp T  &kp Y  &kp U          &kp I  &kp O      &kp P          &kp DELETE
&kp LA(GRAVE)  &kp A         &kp S         &kp D  &kp F  &kp G  &kp H  &kp J          &kp K  &kp L      &kp SEMICOLON  &kp MINUS
&kp LSHFT      &kp Z         &kp X         &kp C  &kp V  &kp B  &none  &kp ENTER      &kp N  &kp M      &kp COMMA      &kp DOT        &kp SLASH  &kp EQUAL
&kp LCTRL      &kp LEFT_GUI  &kp LEFT_ALT  &none  &mo 4  &mo 2  &mo 3  &kp BACKSPACE  &none  &kp GRAVE  &kp SQT        &kp BACKSLASH
            >;
        };

        layer_8 {
            bindings = <
&kp TAB        &kp Q         &kp W         &kp E  &kp R   &kp T   &kp Y   &kp U          &kp I  &kp O      &kp P          &kp DELETE
&kp LA(GRAVE)  &kp A         &kp S         &kp D  &kp F   &kp G   &kp H   &kp J          &kp K  &kp L      &kp SEMICOLON  &kp MINUS
&kp LSHFT      &kp Z         &kp X         &kp C  &kp V   &kp B   &none   &kp ENTER      &kp N  &kp M      &kp COMMA      &kp DOT        &kp SLASH  &kp EQUAL
&kp LCTRL      &kp LEFT_GUI  &kp LEFT_ALT  &none  &trans  &trans  &trans  &kp BACKSPACE  &none  &kp GRAVE  &kp SQT        &kp BACKSLASH
            >;
        };

        layer_1 {
            bindings = <
&trans     &kp LC(Q)  &trans     &kp LG(E)  &kp LC(R)  &kp LC(T)  &kp C_AC_HOME  &kp PAGE_UP     &kp UP_ARROW      &kp END          &kp PRINTSCREEN  &trans
&m_wclick  &kp LC(A)  &kp LC(S)  &trans     &kp LC(F)  &kp LC(G)  &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW    &kp RIGHT_ARROW  &mkp MB4         &mkp MB5
&mkp LCLK  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)  &trans         &kp SPACE       &kp LC(UP_ARROW)  &kp LA(PG_UP)    &trans           &kp LA(PAGE_DOWN)  &trans  &trans
&mkp RCLK  &trans     &trans     &trans     &trans     &trans     &trans         &kp LCTRL       &trans            &trans           &trans           &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&kp ESCAPE  &kp N1    &kp N2  &kp N3    &kp N4      &kp N5     &kp N6     &kp N7         &kp N8     &kp N9                &kp N0                 &kp DELETE
&trans      &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PRCNT  &kp CARET  &kp AMPERSAND  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans      &trans    &trans  &trans    &trans      &trans     &trans     &trans         &kp TILDE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SLASH
&trans      &trans    &trans  &trans    &trans      &trans     &trans     &trans         &trans     &trans                &trans                 &trans
            >;
        };

        layer_7 {
            bindings = <
&trans     &kp LC(Q)  &trans     &kp LG(E)  &kp LC(R)  &kp LC(T)  &kp C_AC_HOME  &kp PAGE_UP     &kp UP_ARROW      &kp END          &kp PRINTSCREEN  &trans
&m_wclick  &kp LC(A)  &kp LC(S)  &trans     &kp LC(F)  &kp LC(G)  &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW    &kp RIGHT_ARROW  &mkp MB4         &mkp MB5
&mkp LCLK  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)  &trans         &kp SPACE       &kp LC(UP_ARROW)  &kp LA(PG_UP)    &trans           &kp LA(PAGE_DOWN)  &trans  &trans
&mkp RCLK  &trans     &trans     &trans     &trans     &trans     &trans         &kp LCTRL       &trans            &trans           &trans           &trans
            >;
        };

        layer_3 {
            bindings = <
&trans        &kp F1        &kp F2        &kp F3        &kp F4        &kp F5      &trans          &kp FSLH  &kp ASTRK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&trans        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10     &kp HOME        &trans    &kp MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&trans        &kp F11       &kp F12       &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &bt BT_CLR_ALL  &trans    &kp END    &trans           &kp GRAVE        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans          &trans    &trans     &kp KP_NUMBER_0  &kp DOT          &kp EQUAL
            >;
        };
    };
};
